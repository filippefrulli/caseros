generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pgcrypto, pg_stat_statements, uuid_ossp(map: "uuid-ossp"), supabase_vault]
}

// citext + future CHECK constraints (rating, commission rate) are added in
// prisma/migrations/*/check_constraints.sql alongside the generated migration.
// Run `prisma migrate dev` after editing this file.

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SellerType {
  INDIVIDUAL
  TRADER
}

enum NotificationType {
  ORDER_PLACED
  ORDER_PAID
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_REFUNDED
  NEW_MESSAGE
  NEW_REVIEW
  PAYOUT_SENT
  SELLER_APPROVED
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique @map("supabase_id")
  // citext → case-insensitive unique, so Foo@bar.com and foo@bar.com collide.
  email      String   @unique @db.Citext
  name       String?
  avatarUrl  String?  @map("avatar_url")
  locale     String   @default("en")
  // Soft delete for GDPR — anonymize email/name/avatar on deletion while
  // keeping the row so historical orders, reviews, and messages stay intact.
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  seller             SellerProfile?
  orders             Order[]
  reviews            Review[]
  addresses          Address[]
  favorites          Favorite[]
  sentMessages       Message[]
  buyerConversations Conversation[] @relation("BuyerConversations")
  notifications      Notification[]

  @@map("users")
}

// ─── Sellers ──────────────────────────────────────────────────────────────────

model SellerProfile {
  id                   String       @id @default(cuid())
  userId               String       @unique @map("user_id")
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName             String       @unique @map("shop_name")
  slug                 String       @unique
  bio                  String?
  avatarUrl            String?      @map("avatar_url")
  bannerUrl            String?      @map("banner_url")
  country              String       @db.Char(2)
  currency             String       @default("EUR")
  status               SellerStatus @default(PENDING)
  stripeAccountId      String?      @unique @map("stripe_account_id")
  stripeOnboardingDone Boolean      @default(false) @map("stripe_onboarding_done")
  payoutsEnabled       Boolean      @default(false) @map("payouts_enabled")
  // Platform commission taken before paying out to seller (0.0500 = 5%).
  // Decimal(4,4) caps at 0.9999 — semantically truthful (commission < 100%).
  commissionRate       Decimal      @default(0.0500) @map("commission_rate") @db.Decimal(4, 4)
  // Pickup / return address used as from_address on shipping labels
  pickupName        String? @map("pickup_name")
  pickupLine1       String? @map("pickup_line1")
  pickupLine2       String? @map("pickup_line2")
  pickupHouseNumber String? @map("pickup_house_number")
  pickupCity        String? @map("pickup_city")
  pickupPostalCode  String? @map("pickup_postal_code")
  pickupCountry     String? @map("pickup_country") @db.Char(2)
  pickupPhone       String? @map("pickup_phone")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  listings      Listing[]
  conversations Conversation[] @relation("SellerConversations")
  kyc           SellerKyc?
  socialLinks   SellerSocialLinks?
  reviews       Review[]

  @@map("seller_profiles")
}

// ─── Catalogue ────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  listings    Listing[]
  createdAt   DateTime   @default(now())  @map("created_at")

  @@map("categories")
}

model Listing {
  id          String        @id @default(cuid())
  sellerId    String        @map("seller_id")
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String?       @map("category_id")
  category    Category?     @relation(fields: [categoryId], references: [id])
  title       String
  slug        String        @unique
  description String
  // Stored in smallest currency unit (cents).
  priceAmount Int           @map("price_amount")
  currency    String        @default("EUR")
  stock       Int           @default(1)
  isDigital   Boolean       @default(false) @map("is_digital")
  videoUrl    String?       @map("video_url")
  // Shipping — required for physical listings; ignored when isDigital.
  weightGrams Int? @map("weight_grams")
  lengthCm    Int? @map("length_cm")
  widthCm     Int? @map("width_cm")
  heightCm    Int? @map("height_cm")
  status      ListingStatus @default(DRAFT)
  // Soft delete — preserve FK integrity for historical orders
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  images        ListingImage[]
  orderItems    OrderItem[]
  favorites     Favorite[]
  conversations Conversation[]

  // Shop page filters (sellerId, status=ACTIVE, deletedAt IS NULL) — composite covers it.
  @@index([sellerId, status, deletedAt])
  @@index([categoryId])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  altText   String?  @map("alt_text")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([listingId])
  @@map("listing_images")
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Address {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  line1       String
  line2       String?
  houseNumber String?  @map("house_number")
  city        String
  postalCode  String   @map("postal_code")
  country     String   @db.Char(2)
  phone       String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("addresses")
}

model Order {
  id      String      @id @default(cuid())
  buyerId String      @map("buyer_id")
  buyer   User        @relation(fields: [buyerId], references: [id])
  status  OrderStatus @default(PENDING)

  // Shipping address — fully snapshotted at order time so later edits or
  // deletion of the buyer's saved Address don't rewrite past receipts.
  shippingName        String? @map("shipping_name")
  shippingLine1       String? @map("shipping_line1")
  shippingLine2       String? @map("shipping_line2")
  shippingHouseNumber String? @map("shipping_house_number")
  shippingCity        String? @map("shipping_city")
  shippingPostalCode  String? @map("shipping_postal_code")
  shippingCountry     String? @map("shipping_country") @db.Char(2)
  shippingPhone       String? @map("shipping_phone")

  totalAmount    Int    @map("total_amount")
  // INVARIANT: a cart contains items from a single seller. Shipping/tracking
  // live on Order. If multi-seller carts are introduced, move these to a
  // Shipment model keyed by (orderId, sellerId).
  shippingAmount Int    @default(0) @map("shipping_amount")
  currency       String @default("EUR")

  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")
  // Captured from payment_intent.latest_charge; used as source_transaction when releasing the seller transfer.
  stripeChargeId        String? @unique @map("stripe_charge_id")
  // Stripe Checkout Session id; set at /api/checkout time, before the PI exists.
  checkoutSessionId     String? @unique @map("checkout_session_id")

  // Shipping label & tracking (provider-agnostic)
  shippingTransactionId String? @unique @map("shipping_transaction_id")
  trackingCode          String? @map("tracking_code")
  trackingUrl           String? @map("tracking_url")
  labelDocumentLink     String? @map("label_document_link")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   OrderItem[]
  reviews Review[]

  @@index([buyerId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Listing FK set to null if listing is hard-deleted; snapshots preserve the receipt
  listingId String?  @map("listing_id")
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  // Snapshots of listing state at order time — receipt stays accurate after edits/deletion
  listingTitle    String  @map("listing_title")
  listingImageUrl String? @map("listing_image_url")

  // Seller context denormalized for efficient seller dashboard queries
  sellerId              String  @map("seller_id")
  sellerStripeAccountId String? @map("seller_stripe_account_id")

  quantity     Int @default(1)
  unitAmount   Int @map("unit_amount")
  sellerPayout Int @map("seller_payout")

  // Set after Stripe transfer is created for this seller's payout
  stripeTransferId String?   @unique @map("stripe_transfer_id")
  payoutReleasedAt DateTime? @map("payout_released_at")
  // Amount refunded so far (cents). Equals unitAmount * quantity when fully refunded.
  refundedAmount   Int       @default(0) @map("refunded_amount")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@index([listingId])
  @@index([sellerId, createdAt])
  @@map("order_items")
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id       String        @id @default(cuid())
  orderId  String        @map("order_id")
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId String        @map("seller_id")
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  authorId String        @map("author_id")
  author   User          @relation(fields: [authorId], references: [id])
  // CHECK (rating BETWEEN 1 AND 5) — applied via raw SQL migration.
  rating   Int
  body     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // One review per (order, seller) — supports multi-seller orders.
  @@unique([orderId, sellerId])
  @@index([sellerId, createdAt])
  @@index([authorId])
  @@map("reviews")
}

// ─── Favourites ───────────────────────────────────────────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, listingId])
  @@index([userId])
  @@map("favorites")
}

// ─── Messaging ────────────────────────────────────────────────────────────────

// One thread per buyer↔seller pair. Optional listingId for initial context only —
// the unique constraint enforces one thread per pair regardless of listing.
model Conversation {
  id            String        @id @default(cuid())
  buyerId       String        @map("buyer_id")
  buyer         User          @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId      String        @map("seller_id")
  seller        SellerProfile @relation("SellerConversations", fields: [sellerId], references: [id])
  listingId     String?       @map("listing_id")
  listing       Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // Denormalized — bumped whenever a Message is created. Powers inbox sort
  // and unread checks without a per-row subquery on messages.
  lastMessageAt   DateTime  @default(now()) @map("last_message_at")
  buyerLastReadAt  DateTime? @map("buyer_last_read_at")
  sellerLastReadAt DateTime? @map("seller_last_read_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  messages Message[]

  @@unique([buyerId, sellerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String?
  // Generic pointer to the related entity (e.g. orderId, conversationId)
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// ─── Seller Social Links ──────────────────────────────────────────────────────

model SellerSocialLinks {
  id        String        @id @default(cuid())
  sellerId  String        @unique @map("seller_id")
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  website   String?
  instagram String?
  tiktok    String?
  youtube   String?
  facebook  String?
  twitter   String?
  pinterest String?
  linkedin  String?

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("seller_social_links")
}

// ─── Seller KYC ───────────────────────────────────────────────────────────────

model SellerKyc {
  id       String        @id @default(cuid())
  sellerId String        @unique @map("seller_id")
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  sellerType SellerType @map("seller_type")

  // Individual identity fields. Country inherits from SellerProfile.country.
  fullName     String?   @map("full_name")
  addressLine1 String?   @map("address_line_1")
  addressLine2 String?   @map("address_line_2")
  city         String?
  postalCode   String?   @map("postal_code")
  dateOfBirth  DateTime? @map("date_of_birth")

  // Trader business fields
  businessRegNumber String? @map("business_reg_number")
  safetyCompliant   Boolean @default(false) @map("safety_compliant")
  contactPhone      String? @map("contact_phone")
  contactEmail      String? @map("contact_email")

  // Acknowledgements & verification
  disclaimerAcknowledged Boolean   @default(false) @map("disclaimer_acknowledged")
  verificationVideoUrl   String?   @map("verification_video_url")
  verifiedAt             DateTime? @map("verified_at")
  reviewNotes            String?   @map("review_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("seller_kyc")
}

// ─── Stripe ───────────────────────────────────────────────────────────────────

// Dedup table for Stripe webhook events. The primary key IS the Stripe event id;
// inserting a duplicate (P2002) signals we've already processed this event.
// Prune rows older than ~30 days via cron (Stripe's replay window is shorter).
model StripeWebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("stripe_webhook_events")
}
